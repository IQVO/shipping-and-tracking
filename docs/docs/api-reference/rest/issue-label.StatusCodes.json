{"responses":{"201":{"description":"Label issued (or replayed for a known Idempotency-Key).","content":{"application/json":{"schema":{"type":"object","description":"Label metadata. Never contains the ship-to address. labelRef, trackingNumber and carrier are what vendor-connectivity returns to the vendor.","required":["labelRef","trackingNumber","carrier","poNumber","packageNo","assignmentId","orderId","tier","status","issuedAt"],"properties":{"labelRef":{"type":"string"},"trackingNumber":{"type":"string"},"carrier":{"type":"string"},"poNumber":{"type":"string"},"packageNo":{"type":"integer"},"assignmentId":{"type":"string"},"orderId":{"type":"string"},"tier":{"type":"string","enum":["SAME_DAY","NEXT_DAY","TWO_DAY","STANDARD"],"title":"ServiceTier"},"status":{"type":"string","enum":["ISSUED","VOIDED"],"title":"LabelStatus"},"issuedAt":{"type":"string","format":"date-time"},"voidReason":{"type":"string"},"voidedAt":{"type":"string","format":"date-time"}},"title":"Label"}}}},"400":{"description":"idempotency-key-required. The Idempotency-Key header is missing.","content":{"application/problem+json":{"schema":{"type":"object","description":"RFC 9457 problem details.","required":["type","title","status"],"properties":{"type":{"type":"string","description":"Problem type slug, for example label-already-issued."},"title":{"type":"string"},"status":{"type":"integer"},"detail":{"type":"string"},"instance":{"type":"string"}},"title":"Problem"}}}},"409":{"description":"label-already-issued (ErrLabelAlreadyIssued), tracking-number-taken (ErrTrackingNumberTaken) or concurrent-update (ErrConcurrentUpdate).","content":{"application/problem+json":{"schema":{"type":"object","description":"RFC 9457 problem details.","required":["type","title","status"],"properties":{"type":{"type":"string","description":"Problem type slug, for example label-already-issued."},"title":{"type":"string"},"status":{"type":"integer"},"detail":{"type":"string"},"instance":{"type":"string"}},"title":"Problem"